// Firestore security rules for the Spare Parts Management System.
//
// Paste into: Firebase console -> Firestore Database -> Rules -> Publish.
//
// BEFORE PUBLISHING, turn on anonymous sign-in, or every device is locked out:
//   Firebase console -> Authentication -> Sign-in method -> Anonymous -> Enable
//
// The app signs in by itself once that is on; nothing in the app needs changing.
// Until then it keeps working and says plainly, in Settings, that the store is
// not secured.
//
// What this buys, honestly: it stops anyone who merely has the address of the
// page from reading or overwriting the store. It does NOT enforce the app's own
// roles and warehouse scopes - every signed-in device is equal here, and the
// per-account permissions are applied by the app, not by these rules. Enforcing
// those server-side needs real per-user accounts and custom claims, which is a
// larger piece of work.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Everything the app shares: sites, parts, tools, pos, users, log, photos.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

